# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API)
#
# Estas duas chaves são públicas por design — elas ficam visíveis no bundle do
# navegador. Quem protege os dados é a Row Level Security do banco.
# NUNCA coloque aqui a chave "service_role".

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
